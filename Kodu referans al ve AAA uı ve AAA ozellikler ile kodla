    mobileGui = gui

    local container = Instance.new("Frame")
    container.Name                 = "BtnContainer"
    container.BackgroundTransparency = 1
    container.AnchorPoint          = Vector2.new(1, 0.5)
    container.Position             = UDim2.new(1, -8, 0.55, 0)
    container.Size                 = UDim2.fromOffset(60, 134)
    container.Parent               = gui

    local uiList = Instance.new("UIListLayout")
    uiList.SortOrder   = Enum.SortOrder.LayoutOrder
    uiList.Padding     = UDim.new(0, 8)
    uiList.HorizontalAlignment = Enum.HorizontalAlignment.Center
    uiList.Parent      = container

    local function makeBtn(label, sublabel, bgColor, strokeColor, order)
        local btn = Instance.new("TextButton")
        btn.BackgroundColor3      = bgColor
        btn.BackgroundTransparency= 0.10
        btn.BorderSizePixel       = 0
        btn.Size                  = UDim2.fromOffset(56, 56)
        btn.Text                  = ""
        btn.LayoutOrder           = order
        btn.AutoButtonColor       = false
        btn.Parent                = container
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 13)

        local stroke = Instance.new("UIStroke", btn)
        stroke.Color       = strokeColor
        stroke.Thickness   = 1.8
        stroke.Transparency= 0.22

        local shine = Instance.new("Frame", btn)
        shine.BackgroundColor3       = Color3.new(1,1,1)
        shine.BackgroundTransparency = 0.82
        shine.BorderSizePixel        = 0
        shine.Size                   = UDim2.new(1, 0, 0.44, 0)
        Instance.new("UICorner", shine).CornerRadius = UDim.new(0, 11)

        local lbl = Instance.new("TextLabel", btn)
        lbl.BackgroundTransparency = 1
        lbl.Size                   = UDim2.new(1, 0, 0.52, 0)
        lbl.Position               = UDim2.fromScale(0, 0.07)
        lbl.Text                   = label
        lbl.Font                   = Enum.Font.GothamBlack
        lbl.TextColor3             = Color3.new(1, 1, 1)
        lbl.TextScaled             = true
        lbl.TextTransparency       = 0.04

        local sub = Instance.new("TextLabel", btn)
        sub.BackgroundTransparency = 1
        sub.Size                   = UDim2.new(1, 0, 0.33, 0)
        sub.Position               = UDim2.fromScale(0, 0.63)
        sub.Text                   = sublabel
        sub.Font                   = Enum.Font.GothamSemibold
        sub.TextColor3             = GOLD
        sub.TextScaled             = true
        sub.TextTransparency       = 0.08

        return btn, stroke
    end

    local shBtn, shStroke = makeBtn("Z", "SHIKAI", Color3.fromRGB(52, 18, 100), ACCENT, 1)
    local bkBtn, bkStroke = makeBtn("B", "BANKAI", Color3.fromRGB(60, 22, 5), ORANGE, 2)

    local function pressAnim(btn, stroke, glowColor)
        tween(btn, 0.07, Enum.EasingStyle.Sine, Enum.EasingDirection.Out,
            {BackgroundTransparency = 0.0, Size = UDim2.fromOffset(52, 52)})
        tween(stroke, 0.07, Enum.EasingStyle.Sine, Enum.EasingDirection.Out,
            {Color = glowColor, Thickness = 2.8, Transparency = 0.0})
        task.delay(0.14, function()
            tween(btn, 0.20, Enum.EasingStyle.Quint, Enum.EasingDirection.Out,
                {BackgroundTransparency = 0.10, Size = UDim2.fromOffset(56, 56)})
            tween(stroke, 0.20, Enum.EasingStyle.Quint, Enum.EasingDirection.Out,
                {Thickness = 1.8, Transparency = 0.22})
        end)
    end

    local shineConn, bankaiShineConn
    local function shikaiActiveGlow()
        if shineConn then shineConn:Disconnect() end
        shineConn = RunService.Heartbeat:Connect(function()
            if not isShikaiActive then
                shStroke.Color = ACCENT
                shStroke.Transparency = 0.22
                if shineConn then shineConn:Disconnect() end
                return
            end
            local pulse = 0.5 + math.sin(os.clock() * 4.2) * 0.5
            shStroke.Transparency = 0.04 + pulse * 0.34
            shStroke.Thickness = 1.8 + pulse * 0.85
        end)
    end
    local function bankaiActiveGlow()
        if bankaiShineConn then bankaiShineConn:Disconnect() end
        bankaiShineConn = RunService.Heartbeat:Connect(function()
            if not isBankaiActive then
                bkStroke.Color = ORANGE
                bkStroke.Transparency = 0.22
                if bankaiShineConn then bankaiShineConn:Disconnect() end
                return
            end
            local pulse = 0.5 + math.sin(os.clock() * 3.6 + 1.1) * 0.5
            bkStroke.Transparency = 0.0 + pulse * 0.28
            bkStroke.Thickness = 1.8 + pulse * 1.25
        end)
    end

    local function onShikaiPress()
        pressAnim(shBtn, shStroke, Color3.fromRGB(225, 145, 255))
        onShikai()
        shikaiActiveGlow()
    end
    local function onBankaiPress()
        pressAnim(bkBtn, bkStroke, Color3.fromRGB(255, 185, 85))
        onBankai()
        bankaiActiveGlow()
    end

    shBtn.MouseButton1Down:Connect(onShikaiPress)
    shBtn.TouchTap:Connect(onShikaiPress)
    bkBtn.MouseButton1Down:Connect(onBankaiPress)
    bkBtn.TouchTap:Connect(onBankaiPress)
end

