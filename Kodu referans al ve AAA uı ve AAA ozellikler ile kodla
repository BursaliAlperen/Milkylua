        T.leftShoulder  = CF(0,0,0) * ANGLES(RAD(10), 0, RAD(-22))
    end

    return T
end

function AnimController:ApplyPose(targets, alpha)
    for k, motor in pairs(self.Motors) do
        if motor and self.BaseC0[k] then
            local offset = targets[k] or CFrame.new()
            motor.C0 = Clerp(motor.C0, self.BaseC0[k] * offset, alpha)
        end
    end
end

function AnimController:Update(dt)
    if not character or not root or not humanoid or humanoid.Health <= 0 then return end
    self.Sine += dt * 7.2
    local locked = self.StateEndsAt > os.clock()
    if not locked then self.State = self:AutoState() end

    if self.State == "Airwalk" or self.State == "BankaiIdle" or self.State == "BankaiMove" then
        local cam    = workspace.CurrentCamera
        local look   = cam and cam.CFrame.LookVector or root.CFrame.LookVector
        local flatL  = Vector3.new(look.X, 0, look.Z)
        if flatL.Magnitude > 0.05 then flatL = flatL.Unit end
        local mi   = humanoid and humanoid.MoveDirection or Vector3.zero
        local move = Vector3.zero
        if mi.Magnitude > 0.05 then move = Vector3.new(mi.X, 0, mi.Z) end
        if move.Magnitude > 1 then move = move.Unit end
        local hover = Vector3.new(0, math.sin(os.clock()*3.0)*1.0, 0)
        local lerpF = 1 - (1 - AIRWALK_ACCEL_ALPHA) ^ (dt / (1/60))
        airwalkVelocity = airwalkVelocity:Lerp(move * AIRWALK_SPEED + hover, lerpF)
        if airwalkActive or isBankaiActive then
            root.AssemblyLinearVelocity = airwalkVelocity
        end
        local face = move.Magnitude > 0.05 and move or flatL
        if face.Magnitude > 0.05 then
            local rotLerp = 1 - (1 - 0.12) ^ (dt / (1/60))
            root.CFrame = root.CFrame:Lerp(CFrame.new(root.Position, root.Position + face.Unit), rotLerp)
        end
    else
        local lerpF = 1 - (1 - 0.20) ^ (dt / (1/60))
        airwalkVelocity = airwalkVelocity:Lerp(Vector3.zero, lerpF)
    end

    if not locked and (self.State == "Move" or self.State == "ShikaiMove" or self.State == "BankaiMove") then return end

    local targetAlpha = locked and 0.30 or 0.14
    local alpha = 1 - (1 - targetAlpha) ^ (dt / (1/60))
    alpha = math.clamp(alpha, 0, 1)

    local targets = self:TargetPose(self.State)
    if targets then self:ApplyPose(targets, alpha) end
end

local function installProceduralAnimationEngine()
    AnimController:RefreshMotors()
    if not AnimController.Connected then
        AnimController.Connected = true
        RunService.RenderStepped:Connect(function(dt)
            AnimController:Update(dt)
        end)
    end
end

