-- FLING SYSTEM (ULTRA + TELEPORT)
-- ============================================================
local function flingTarget(targetHumanoid, flingPower, flingDirection)
    if not targetHumanoid or not targetHumanoid.Parent then return end
    if targetHumanoid.Parent == character then return end
    local targetRoot = targetHumanoid.Parent:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end

    -- Ana fling (BodyVelocity)
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = flingDirection.Unit * flingPower
    bv.Parent   = targetRoot
    Debris:AddItem(bv, 0.2)

    -- Fırlatma dönüşü
    local bav = Instance.new("BodyAngularVelocity")
    bav.MaxTorque      = Vector3.new(math.huge, math.huge, math.huge)
    bav.AngularVelocity= Vector3.new(rng:NextNumber(-150, 150), rng:NextNumber(-150, 150), rng:NextNumber(-150, 150))
    bav.Parent         = targetRoot
    Debris:AddItem(bav, 0.2)

    -- Kısa süreli sersemletme (stun)
    local human = targetHumanoid
    local oldWalk = human.WalkSpeed
    human.WalkSpeed = 0
    task.delay(0.25, function()
        if human and human.Parent then
            human.WalkSpeed = oldWalk
        end
    end)

    cameraPulse(0.9, 0.3)
    applyPostProcessing(2.2, 0, 0.25, 0.45)
    playSound(SOUNDS.Impact, 2.0, 1.1)

    local iPos = targetRoot.Position
    orb(iPos, 4.5, RED_HIT, 0.35)
    ring(CF(iPos), 7.0, RED_HIT, 0.45, 0.25)
    burstRays(iPos, RED_HIT, 10, 10, 0.4)
end

-- Işınlama (spawn veya rastgele nokta)
local function teleportToSpawn(targetHumanoid)
    if not targetHumanoid or not targetHumanoid.Parent then return end
    local targetRoot = targetHumanoid.Parent:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end
    
    local spawnLocation = Workspace:FindFirstChild("SpawnLocation")
    local targetPos = Vector3.new(0, 5, 0)
    if spawnLocation then
        targetPos = spawnLocation.Position + Vector3.new(0, 3, 0)
    else
        -- Rastgele güvenli nokta
        targetPos = Vector3.new(
            rng:NextNumber(-50, 50),
            5,
            rng:NextNumber(-50, 50)
        )
    end
    targetRoot.CFrame = CF(targetPos)
    
    -- Işınlanma efekti
    orb(targetPos, 3, WHITE, 0.5)
    ring(CF(targetPos), 5, WHITE, 0.4, 0.15)
    playSound(SOUNDS.Flash, 1.2, 1.4)
end

local function getNearestEnemy(range)
    local nearest, nearestDist = nil, range or 60
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local hr = p.Character:FindFirstChild("HumanoidRootPart")
            local hm = p.Character:FindFirstChild("Humanoid")
            if hr and hm and hm.Health > 0 then
                local dist = (hr.Position - root.Position).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                    nearest = hm
                end
            end
        end
    end
    return nearest
end

local function getAllEnemiesInRange(center, range)
    local enemies = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local hr = p.Character:FindFirstChild("HumanoidRootPart")
            local hm = p.Character:FindFirstChild("Humanoid")
            if hr and hm and hm.Health > 0 then
                local dist = (hr.Position - center).Magnitude
                if dist < range then
                    table.insert(enemies, {hum = hm, root = hr, dist = dist})
                end
            end
        end
    end
    return enemies
end

