local function sendChat(msg)
    -- Method 1: SayMessageRequest (most common)
    local ok = pcall(function()
        local re = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if re then
            local sayRE = re:FindFirstChild("SayMessageRequest")
            if sayRE then
                sayRE:FireServer(msg, "All")
                return
            end
        end
    end)
    if ok then return end

    -- Method 2: Legacy Chat RemoteEvent
    pcall(function()
        local chatRE = ReplicatedStorage:FindFirstChild("SayMessageRequest") or
                       ReplicatedStorage:FindFirstChild("ChatRemote")
        if chatRE and chatRE:IsA("RemoteEvent") then
            chatRE:FireServer(msg, "All")
        end
    end)

    -- Method 3: Chat service (local bubble)
    pcall(function()
        local head = character:FindFirstChild("Head") or root
        Chat:Chat(head, msg, Enum.ChatColor.Blue)
    end)
end

