local function playCutscene(camStartCF, camEndCF, duration, easingStyle, screenEffects, soundId, soundVol, soundPitch)
    local cam = workspace.CurrentCamera
    if not cam then return end

    cameraSequenceToken += 1
    local token = cameraSequenceToken

    cam.CameraType = Enum.CameraType.Scriptable
    cam.CFrame     = camStartCF

    local tw = TweenService:Create(
        cam,
        TweenInfo.new(duration, easingStyle or Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
        {CFrame = camEndCF}
    )
    tw:Play()

    if screenEffects then
        local oldBloom = ppSettings.Bloom.Intensity
        local oldSat   = ppSettings.Color.Saturation
        local oldCon   = ppSettings.Color.Contrast

        tween(ppSettings.Bloom, duration * 0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.Out,
            {Intensity  = screenEffects.bloom    or oldBloom})
        tween(ppSettings.Color, duration * 0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.Out,
            {Saturation = screenEffects.saturation or oldSat,
             Contrast   = screenEffects.contrast    or oldCon})

        task.delay(duration, function()
            tween(ppSettings.Bloom, 0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.In, {Intensity  = oldBloom})
            tween(ppSettings.Color, 0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.In,
                {Saturation = oldSat, Contrast = oldCon})
        end)
    end

    if soundId then
        playSound(soundId, soundVol or 1, soundPitch or 1)
    end

    tw.Completed:Wait()

    if token == cameraSequenceToken then
        cam.CameraType = Enum.CameraType.Custom
    end
end

