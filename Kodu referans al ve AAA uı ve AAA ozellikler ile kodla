local function cameraPulse(power, duration)
    local cam   = workspace.CurrentCamera
    if not cam then return end
    local start = os.clock()
    local conn
    conn = RunService.RenderStepped:Connect(function()
        local alpha = (os.clock() - start) / duration
        if alpha >= 1 then conn:Disconnect(); return end
        local f = (1 - alpha) * (1 - alpha)
        cam.CFrame = cam.CFrame * CF(
            rng:NextNumber(-power, power) * f,
            rng:NextNumber(-power, power) * f,
            rng:NextNumber(-power, power) * f
        )
    end)
end

local function applyPostProcessing(bloom, blur, saturation, duration)
    local oldBloom = ppSettings.Bloom.Intensity
    local oldSat   = ppSettings.Color.Saturation
    local oldBlur  = ppSettings.Blur.Size
    ppSettings.Blur.Enabled = (blur > 0)
    tween(ppSettings.Bloom, 0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, {Intensity  = bloom})
    tween(ppSettings.Color, 0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, {Saturation = saturation})
    if blur > 0 then
        tween(ppSettings.Blur, 0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, {Size = blur})
    end
    task.delay(duration, function()
        tween(ppSettings.Bloom, 0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.In, {Intensity  = oldBloom})
        tween(ppSettings.Color, 0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.In, {Saturation = oldSat})
        if oldBlur == 0 then
            tween(ppSettings.Blur, 0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.In, {Size = 0, Enabled = false})
        end
    end)
end

