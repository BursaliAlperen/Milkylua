-- COOLDOWN SYSTEM
-- ============================================================
local function isOnCooldown(key)
    return activeCooldowns[key] and os.clock() < activeCooldowns[key]
end

local function setCooldown(key, seconds)
    activeCooldowns[key] = os.clock() + seconds
end

local function getCooldownRemaining(key)
    if not activeCooldowns[key] then return 0 end
    return math.max(0, activeCooldowns[key] - os.clock())
end

