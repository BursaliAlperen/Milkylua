-- DEATH RESET
-- ============================================================
local function deathReset()
    humanoid.Died:Connect(function()
        airwalkActive    = false
        airwalkDirection = Vector3.zero
        airwalkVelocity  = Vector3.zero
        isShikaiActive   = false
        isBankaiActive   = false
        if humanoid then
            humanoid.AutoRotate     = true
            humanoid.PlatformStand  = false
        end
        cleanupBin:ClearAllChildren()
        AnimController:SetState("Idle")
    end)
end

local function refreshCharacter(newChar)
    character = newChar
    humanoid  = character:WaitForChild("Humanoid")
    root      = character:WaitForChild("HumanoidRootPart")
end
player.CharacterAdded:Connect(refreshCharacter)

-- ============================================================
-- KEYBOARD INPUT
-- ============================================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.Z then
        activateShikai()
    elseif input.KeyCode == Enum.KeyCode.B then
        activateBankai()
    elseif input.KeyCode == Enum.KeyCode.Q then
        useReiatsu()
    elseif input.KeyCode == Enum.KeyCode.E then
        useKyokaSuigetsu()
    elseif input.KeyCode == Enum.KeyCode.R then
        useFlashStep()
    elseif input.KeyCode == Enum.KeyCode.T then
        useHado90()
    elseif input.KeyCode == Enum.KeyCode.F then
        useByakurai()
    elseif input.KeyCode == Enum.KeyCode.G then
        useCero()
    elseif input.KeyCode == Enum.KeyCode.H then
        useAura()
    end
end)

-- ============================================================
-- STARTER
-- ============================================================
local function startKit()
    installProceduralAnimationEngine()
    deathReset()

    createToolGui()
    createMobileButtons(activateShikai, activateBankai)

    player.CharacterAdded:Connect(function(newChar)
        task.wait(0.4)
        character = newChar
        humanoid  = character:WaitForChild("Humanoid")
        root      = character:WaitForChild("HumanoidRootPart")
        isShikaiActive = false
        isBankaiActive = false
        AnimController:RefreshMotors()
        installProceduralAnimationEngine()
        deathReset()
        createToolGui()
        createMobileButtons(activateShikai, activateBankai)
    end)

    createIntroGui(function()
        task.delay(0.35, function()
            cinematicCaption("AIZEN FE", "TYBW Delta+ System Active", 3.2)
            task.delay(0.2, function()
                notify("Aizen FE", "TYBW Delta+ Loaded! Left=Tools, Right=Shikai/Bankai", 6)
            end)
        end)
    end)
end

startKit()

