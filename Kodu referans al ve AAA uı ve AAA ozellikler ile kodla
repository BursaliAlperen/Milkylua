local function lightningChain(fromPos, toPos, color, segments, lifetime)
    local dir  = (toPos - fromPos)
    local prev = fromPos
    for i = 1, (segments or 8) do
        local t    = i / (segments or 8)
        local mid  = fromPos + dir * t
        local jitter = Vector3.new(
            rng:NextNumber(-3.5, 3.5),
            rng:NextNumber(-3.5, 3.5),
            rng:NextNumber(-3.5, 3.5)
        )
        if i == segments then jitter = Vector3.zero end
        local next = mid + jitter
        local segDist  = (next - prev).Magnitude
        local segMid   = (next + prev) / 2
        local p = makePart("LightSeg", Vector3.new(0.3, 0.3, segDist),
            CF(segMid, next), color, Enum.Material.Neon, 0.0)
        tween(p, lifetime or 0.28, Enum.EasingStyle.Sine, Enum.EasingDirection.In, {Transparency = 1})
        Debris:AddItem(p, (lifetime or 0.28) + 0.06)
        prev = next
    end
end

local function burstRays(pos, color, count, length, lifetime)
    for i = 1, (count or 12) do
        local angle = (i / (count or 12)) * math.pi * 2
        local dir   = Vector3.new(math.cos(angle), 0, math.sin(angle))
        local endP  = pos + dir * (length or 18)
        beamVFX(pos, endP, color, 0.48, lifetime or 0.58)
    end
    -- Ekstra ışık hüzmeleri yukarı
    for i = 1, 6 do
        local ang = math.rad(i * 60)
        local upDir = Vector3.new(math.cos(ang), 0.5, math.sin(ang)).Unit
        beamVFX(pos, pos + upDir * (length * 0.7), color, 0.3, lifetime or 0.5)
    end
end

local function orbitalRings(attachTo, color, ringCount, duration)
    if not attachTo then return end
    local rings = {}
    local startT = os.clock()
    for i = 1, (ringCount or 3) do
        local p = Instance.new("Part")
        p.Name         = "OrbitalRing"
        p.Anchored     = true
        p.CanCollide   = false
        p.CanTouch     = false
        p.CanQuery     = false
        p.CastShadow   = false
        p.Size         = Vector3.new(0.2, 0.2, 1.2)
        p.Color        = color
        p.Material     = Enum.Material.Neon
        p.Transparency = 0.08
        p.Parent       = cleanupBin
        table.insert(rings, p)
    end
    local conn
    conn = RunService.Heartbeat:Connect(function()
        local elapsed = os.clock() - startT
        if elapsed > (duration or 4) or not attachTo.Parent then
            conn:Disconnect()
            for _, rp in ipairs(rings) do rp:Destroy() end
            return
        end
        local fade = math.min(1, math.max(0, 1 - (elapsed - (duration or 4) + 0.8) / 0.8))
        local rootCF = attachTo.CFrame
        for i, rp in ipairs(rings) do
            local tOff = elapsed * 2.8 + (i - 1) * (math.pi * 2 / #rings)
            local r    = 4.5 + math.sin(elapsed * 3.5 + i) * 0.8
            local lx   = math.cos(tOff) * r
            local lz   = math.sin(tOff) * r
            local ly   = math.sin(elapsed * 2.2 + i * 1.3) * 1.8
            local worldPos = rootCF.Position + Vector3.new(lx, ly, lz)
            local look     = rootCF.Position + Vector3.new(lx * 2, ly, lz * 2)
            rp.CFrame      = CF(worldPos, look)
            rp.Transparency = 1 - fade * 0.92
        end
    end)
end

